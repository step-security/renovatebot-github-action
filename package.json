{
  "name": "renovatebot-github-action",
  "version": "46.3.13",
  "private": true,
  "description": "GitHub Action to run Renovate self-hosted.",
  "homepage": "https://github.com/step-security/renovatebot-github-action#readme",
  "bugs": {
    "url": "https://github.com/step-security/renovatebot-github-action/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "step-security",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/renovatebot-github-action.git"
  },
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "rimraf dist/ && ncc build src/index.ts -o dist",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "axios": "^1.18.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@containerbase/oxlint-plugin": "1.1.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.19.2",
    "@vercel/ncc": "^0.44.1",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
